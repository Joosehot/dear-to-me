# Caddy in front of Dear to Me. {$D2M_DOMAIN} comes from deploy/.env (through docker-compose.yml).
# Caddy gets and renews the HTTPS certificate itself (Let's Encrypt), and redirects HTTP to HTTPS.

{
	# the address Let's Encrypt writes to about the certificate (optional)
	email {$ACME_EMAIL}

	# Cloudflare's proxy (orange cloud) in front of Caddy: trust its addresses, so the visitor's own
	# address reaches the app (and set D2M_TRUST_PROXY=2 in .env). The list is
	# https://www.cloudflare.com/ips/ (check it is still the same). Off with DNS only (grey cloud).
	# servers {
	# 	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# }
}

{$D2M_DOMAIN} {
	# text compressed (pictures and videos are already)
	encode zstd gzip

	# the app's own limits are smaller (a picture 10 MB, a vlog 500 MB when it goes through the app
	# without R2); with R2 a vlog goes straight from the browser into the bucket, not through here
	request_body {
		max_size 520MB
	}

	# the app, websockets (/ws) included; X-Forwarded-For and -Proto set for it
	reverse_proxy app:5174 {
		# a long upload or a live conversation is not cut off
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	log {
		output stdout
		format console
	}
}

# www. to the bare domain (its DNS record is optional; without it Caddy gets no certificate for it,
# and only logs that)
www.{$D2M_DOMAIN} {
	redir https://{$D2M_DOMAIN}{uri} permanent
}
